ROLE=head
VLLM_IMAGE=ghcr.io/spark-arena/dgx-vllm-eugr-nightly-tf5:latest
HOST_IP=192.168.100.1
HEAD_IP=192.168.100.1
IF_NAME=enp1s0f0np0
IB_HCA=rocep1s0f0,roceP2p1s0f0
NUM_NODES=2
# Verifierad fungerande 2026-09-20
MODEL=local-inference-lab/GLM-5.3-Flash-NVFP4-Spark
VLLM_EXTRA_ARGS=--served-model-name glm-5.3-flash --trust-remote-code --max-model-len 262144 --gpu-memory-utilization 0.80 --enable-auto-tool-choice --tool-call-parser glm47 --reasoning-parser glm47 --enable-prefix-caching --enable-chunked-prefill --max-num-seqs 8
VLLM_API_KEY=<sätt-din-egen>
HF_TOKEN=<sätt-din-egen>
