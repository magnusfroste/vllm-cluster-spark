#!/usr/bin/env python3
"""vllmapp-agent — runs on each node as an SSH forced command.

The app in Easypanel reaches the node with a key that may only run this
script (authorized_keys: command="~/.local/bin/vllmapp-agent",restrict).
The command arrives in SSH_ORIGINAL_COMMAND and is allowlisted here.

Config: ~/.config/vllmapp/agent.env (CLUSTER_DIR=...).
"""
import json
import os
import re
import shlex
import subprocess
import sys
import time

VERSION = "11"
HOME = os.path.expanduser("~")
CONF = os.path.join(HOME, ".config/vllmapp/agent.env")

# Files the app may read/write in the cluster dir (managed mode)
WRITABLE = re.compile(r"^(compose\.yaml|entrypoint\.sh|\.env|patches/[A-Za-z0-9_.-]+)$")

# Log lines that say something about startup phase or errors
SCAN = re.compile(
    r"Loading safetensors checkpoint shards|Available KV cache memory|GPU KV cache size"
    r"|Maximum concurrency|Running FlashInfer autotune"
    r"|Capturing CUDA graph|Graph capturing finished|Application startup complete"
    r"|Starting vLLM API server|Starting vLLM with|Väntar på|Alla noder uppe|All nodes up"
    r"|Traceback|RuntimeError|ValueError|Timed out|out of memory|No available memory"
    r"|ActorDied|ActorHandleNotFound|RayWorkerError|Killed"
)


def conf():
    c = {"CLUSTER_DIR": os.path.join(HOME, "vllm-cluster")}
    try:
        for line in open(CONF):
            line = line.strip()
            if line and not line.startswith("#") and "=" in line:
                k, v = line.split("=", 1)
                c[k.strip()] = os.path.expanduser(v.strip())
    except FileNotFoundError:
        pass
    return c


def run(cmd, cwd=None, timeout=60, input=None):
    p = subprocess.run(cmd, cwd=cwd, capture_output=True, text=True,
                       timeout=timeout, input=input)
    return p.returncode, p.stdout, p.stderr


def out(obj):
    json.dump(obj, sys.stdout)
    sys.stdout.write("\n")


def container(c):
    """First container in the compose project in CLUSTER_DIR."""
    if not os.path.isdir(c["CLUSTER_DIR"]):
        return None
    rc, so, _ = run(["docker", "compose", "ps", "-a", "-q"], cwd=c["CLUSTER_DIR"])
    ids = so.split()
    return ids[0] if rc == 0 and ids else None


def gpu():
    try:
        rc, so, _ = run(["nvidia-smi", "--query-gpu=utilization.gpu,temperature.gpu,power.draw",
                         "--format=csv,noheader,nounits"], timeout=15)
    except (OSError, subprocess.TimeoutExpired):
        return None
    if rc != 0 or not so.strip():
        return None
    f = [x.strip() for x in so.strip().splitlines()[0].split(",")]
    num = lambda x: float(x) if re.match(r"^[\d.]+$", x) else None
    return {"util": num(f[0]), "temp": num(f[1]), "power": num(f[2])}


def meminfo():
    m = {}
    for line in open("/proc/meminfo"):
        k, v = line.split(":")
        m[k] = int(v.split()[0]) * 1024
    return {"total": m["MemTotal"], "available": m["MemAvailable"]}


def can_reboot():
    rc, _, _ = run(["sudo", "-n", "-l", "/usr/bin/systemctl", "reboot"], timeout=10)
    return rc == 0


def status(c, args=()):
    cid = container(c)
    info = None
    if cid:
        rc, so, _ = run(["docker", "inspect", cid])
        if rc == 0:
            d = json.loads(so)[0]
            info = {
                "name": d["Name"].lstrip("/"),
                "state": d["State"]["Status"],
                "running": d["State"]["Running"],
                "started_at": d["State"]["StartedAt"],
                "finished_at": d["State"]["FinishedAt"],
                "exit_code": d["State"]["ExitCode"],
                "restarts": d["RestartCount"],
                "image": d["Config"]["Image"],
                "image_id": d["Image"],
            }
    boot = time.time() - float(open("/proc/uptime").read().split()[0])
    out({
        "agent": VERSION,
        "hostname": os.uname().nodename,
        "boot_time": boot,
        "cluster_dir": c["CLUSTER_DIR"],
        "cluster_dir_exists": os.path.isdir(c["CLUSTER_DIR"]),
        "can_reboot": can_reboot(),
        "roce": roce(c),
        "mem": meminfo(),
        "gpu": gpu(),
        "container": info,
        **(setup(c, *args) if len(args) >= 4 else {}),
    })


def scan(c, since):
    cid = container(c)
    if not cid:
        return out({"lines": [], "last": None})
    cmd = ["docker", "logs", "--timestamps"]
    if since:
        cmd += ["--since", since]
    p = subprocess.Popen(cmd + [cid], stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                         text=True, errors="replace")
    lines, last, ready = [], None, False
    for line in p.stdout:
        if "shm_broadcast" in line:
            continue
        last = line.rstrip()[:600]
        ready = ready or "Application startup complete" in line  # kept however long the log gets
        if SCAN.search(line):
            lines.append(last)
            if len(lines) > 800:
                lines = lines[-400:]
    p.wait()
    out({"lines": lines[-400:], "last": last, "ready_seen": ready})


def logs(c, n, since=None):
    cid = container(c)
    if not cid:
        return out({"lines": []})
    cmd = ["docker", "logs", "--timestamps", "--tail", str(n)]
    if since:
        cmd += ["--since", since]
    rc, so, se = run(cmd + [cid])
    # stdout and stderr arrive separately; the timestamps put them back in order
    lines = sorted((so + se).splitlines(), key=lambda l: l[:35])
    out({"lines": [l[:2000] for l in lines[-n:]]})


def roce(c):
    """RoCE v2 GID on index 3 (NCCL_IB_GID_INDEX) for the HCAs in the cluster's .env,
    or for all active ports. An empty GID after a link flap makes NCCL init fail."""
    base = "/sys/class/infiniband"
    if not os.path.isdir(base):
        return None
    want = []
    try:
        for line in open(os.path.join(c["CLUSTER_DIR"], ".env")):
            if line.startswith("IB_HCA="):
                want = [h.strip() for h in line.split("=", 1)[1].split(",") if h.strip()]
    except OSError:
        pass
    res = []
    for dev in sorted(os.listdir(base), key=str.lower):
        d = os.path.join(base, dev)
        state = (read(d + "/ports/1/state") or "").split(":")[-1].strip()
        if want and dev not in want or not want and state != "ACTIVE":
            continue
        gid = read(d + "/ports/1/gids/3") or ""
        try:
            nets = os.listdir(d + "/device/net")
        except OSError:
            nets = []
        res.append({"hca": dev, "state": state, "iface": nets[0] if nets else None,
                    "gid3": gid, "ok": state == "ACTIVE" and bool(gid.strip("0:"))})
    return res


def read(p):
    try:
        return open(p).read().strip()
    except OSError:
        return None


def compose(c, *args, timeout=600):
    rc, so, se = run(["docker", "compose", *args], cwd=c["CLUSTER_DIR"], timeout=timeout)
    out({"rc": rc, "out": (so + se)[-4000:]})


DROP = ["sudo", "-n", "/usr/bin/tee", "/proc/sys/vm/drop_caches"]


def can_drop_caches():
    rc, _, _ = run(["sudo", "-n", "-l", *DROP[2:]], timeout=10)
    return rc == 0


def drop_caches():
    if not can_drop_caches():
        return out({"rc": 1, "no_sudo": True, "out": "missing sudoers rule for drop_caches"})
    cached = lambda: int(next(l.split()[1] for l in open("/proc/meminfo") if l.startswith("Cached:"))) * 1024
    before = cached()  # MemAvailable already counts the cache as free, so measure the cache itself
    run(["sync"], timeout=120)
    rc, so, se = run(DROP, input="3\n", timeout=60)
    out({"rc": rc, "out": se[-300:], "freed_gib": round(max(0, before - cached()) / 2**30, 1)})


def reboot():
    if not can_reboot():
        return out({"rc": 1, "out": "missing sudoers rule for /usr/bin/systemctl reboot"})
    subprocess.Popen(["sh", "-c", "sleep 2; sudo -n /usr/bin/systemctl reboot"],
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL, start_new_session=True)
    out({"rc": 0, "out": "rebooting in 2 s"})


def netdetect(ip):
    """The interface that has ip, and the RoCE HCAs on the same physical port."""
    rc, so, _ = run(["ip", "-o", "-4", "addr"])
    iface = None
    for line in so.splitlines():
        f = line.split()
        if len(f) > 3 and f[3].split("/")[0] == ip:
            iface = f[1]
    port = lambda n: (re.findall(r"p\d+s\d+f\d+", n) or [None])[-1]
    hcas = []
    base = "/sys/class/infiniband"
    if iface and os.path.isdir(base):
        for dev in sorted(os.listdir(base), key=str.lower):
            try:
                nets = os.listdir(os.path.join(base, dev, "device/net"))
            except OSError:
                continue
            if any(n == iface or (port(n) and port(n) == port(iface)) for n in nets):
                hcas.append(dev)
    out({"iface": iface, "hcas": hcas})


def readfile(c, rel):
    if not WRITABLE.match(rel):
        return out({"error": "file not allowed"})
    p = os.path.join(c["CLUSTER_DIR"], rel)
    ok = os.path.exists(p)
    out({"exists": ok, "content": open(p).read() if ok else ""})


def putfile(c, rel):
    if not WRITABLE.match(rel):
        return out({"error": "file not allowed"})
    p = os.path.join(c["CLUSTER_DIR"], rel)
    os.makedirs(os.path.dirname(p), exist_ok=True)
    data = sys.stdin.read()
    if os.path.exists(p):
        if open(p).read() == data:
            return out({"rc": 0, "changed": False})
        os.replace(p, p + ".bak-" + time.strftime("%Y%m%d-%H%M%S"))
    fd = os.open(p, os.O_WRONLY | os.O_CREAT | os.O_TRUNC,
                 0o600 if rel == ".env" else 0o644)
    with os.fdopen(fd, "w") as f:
        f.write(data)
    out({"rc": 0, "changed": True})


# ---------- setup checks and model download ----------
SAFE_PATH = re.compile(r"^[A-Za-z0-9_./${}~-]+$")
SAFE_REPO = re.compile(r"^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$")
SAFE_REV = re.compile(r"^[A-Za-z0-9_.-]+$")
SAFE_IMAGE = re.compile(r"^[A-Za-z0-9_./:@-]+$")
DL_NAME = "vllm-download"


def hf_cache(path):
    return os.path.expanduser(path.replace("${HOME}", HOME).replace("$HOME", HOME))


def repo_dir(cache, repo):
    return os.path.join(cache, "hub", "models--" + repo.replace("/", "--"))


def dl_container():
    """State of the download container: None, or running/exit code and the last log line."""
    rc, so, _ = run(["docker", "inspect", DL_NAME])
    if rc != 0:
        return None
    info = json.loads(so)[0]
    d = info["State"]
    args = info.get("Args") or []
    _, lo, le = run(["docker", "logs", "--tail", "3", DL_NAME])
    last = [l for l in (lo + le).replace("\r", "\n").splitlines() if l.strip()]
    return {"running": d["Running"], "exit_code": d["ExitCode"],
            "repo": args[1] if len(args) > 1 and args[0] == "download" else None,
            "started_at": d["StartedAt"], "finished_at": d["FinishedAt"],
            "last": last[-1][:300] if last else ""}


def model_state(cache, repo, rev):
    d = repo_dir(cache, repo)
    blobs = os.path.join(d, "blobs")
    size, partial = 0, 0
    try:
        for e in os.scandir(blobs):
            size += e.stat().st_size
            partial += e.name.endswith(".incomplete")
    except OSError:
        pass
    snap = rev or read(os.path.join(d, "refs", "main"))
    snapdir = os.path.join(d, "snapshots", snap) if snap else None
    files = os.listdir(snapdir) if snapdir and os.path.isdir(snapdir) else []
    dl = dl_container()
    return {"bytes": size, "partial": partial, "snapshot": snap if files else None,
            "files": len(files), "download": dl,
            "present": bool(files) and not partial and not (dl and dl["running"])}


def setup(c, host_ip, head_ip, cache, repo, rev="", image="-"):
    """Checks that need root to fix, plus the model's state in the HF cache and whether the
    model's vLLM image is on this node (Easypanel's daily cleanup removes unused images)."""
    rev = "" if rev == "-" else rev
    if image != "-" and not SAFE_IMAGE.match(image):
        return {"setup_error": "invalid image"}
    if not (re.match(r"^[\d.]+$", host_ip) and re.match(r"^[\d.]+$", head_ip)
            and SAFE_PATH.match(cache) and (repo == "-" or SAFE_REPO.match(repo))
            and (not rev or SAFE_REV.match(rev))):
        return {"setup_error": "invalid arguments"}
    cache = hf_cache(cache)
    checks = {}
    rc, _, se = run(["docker", "info", "--format", "{{.ServerVersion}}"], timeout=20)
    checks["docker"] = {"ok": rc == 0, "detail": se.strip()[-200:]}
    checks["nvidia_toolkit"] = {"ok": any(os.path.exists(p) for p in
                                          ("/usr/bin/nvidia-container-cli", "/usr/bin/nvidia-ctk"))}
    rc, so, _ = run(["ip", "-o", "-4", "addr"])
    iface = next((l.split()[1] for l in so.splitlines()
                  if len(l.split()) > 3 and l.split()[3].split("/")[0] == host_ip), None)
    checks["link_ip"] = {"ok": bool(iface), "detail": iface or f"{host_ip} is not on any interface"}
    if host_ip != head_ip:
        rc, _, _ = run(["ping", "-c", "1", "-W", "2", head_ip], timeout=10)
        checks["head_reachable"] = {"ok": rc == 0}
    p = cache
    while not os.path.exists(p) and p != "/":
        p = os.path.dirname(p)
    st = os.statvfs(p)
    checks["disk_free"] = {"ok": True, "bytes": st.f_bavail * st.f_frsize}
    if image != "-":
        rc, _, _ = run(["docker", "image", "inspect", "--format", "{{.Id}}", image], timeout=20)
        checks["image"] = {"ok": rc == 0, "detail": image}
    checks["reboot_sudo"] = {"ok": can_reboot(), "optional": True}
    checks["drop_caches_sudo"] = {"ok": can_drop_caches(), "optional": True}
    rc, _, _ = run(["systemctl", "is-active", "--quiet", "vllm-panel-ports.service"])
    checks["cluster_ports"] = {"ok": rc == 0, "optional": True}
    rdma = set()  # the cluster link ports: RoCE interfaces are not for clients
    for dev in os.listdir("/sys/class/infiniband") if os.path.isdir("/sys/class/infiniband") else []:
        try:
            rdma.update(os.listdir(f"/sys/class/infiniband/{dev}/device/net"))
        except OSError:
            pass
    lan = [f[3].split("/")[0] for f in (l.split() for l in so.splitlines())
           if len(f) > 3 and f[1] != iface and f[1] not in rdma
           and not re.match(r"^(lo|docker|br-|veth|virbr|tailscale)", f[1])]
    return {"checks": checks, "lan_ips": lan, "models": models_on_disk(cache),
            "model": model_state(cache, repo, rev) if repo != "-" else None}


def models_on_disk(cache):
    hub = os.path.join(cache, "hub")
    res = []
    for d in sorted(os.listdir(hub)) if os.path.isdir(hub) else []:
        if not d.startswith("models--"):
            continue
        size, partial = 0, 0
        try:
            for e in os.scandir(os.path.join(hub, d, "blobs")):
                size += e.stat().st_size
                partial += e.name.endswith(".incomplete")
        except OSError:
            pass
        res.append({"repo": d[len("models--"):].replace("--", "/", 1), "bytes": size, "partial": partial})
    return res


def configured_model(c):
    try:
        for line in open(os.path.join(c["CLUSTER_DIR"], ".env")):
            if line.startswith("MODEL="):
                return line.split("=", 1)[1].strip()
    except OSError:
        pass
    return None


def delete_model(c, image, cache, repo):
    """Remove a model from the HF cache. The files belong to root (the containers write them),
    so the removal runs in a container. The model the cluster is configured for is refused."""
    if not (SAFE_IMAGE.match(image) and SAFE_PATH.match(cache) and SAFE_REPO.match(repo)):
        return out({"rc": 1, "out": "invalid arguments"})
    if repo == configured_model(c):
        return out({"rc": 1, "out": f"{repo} is the model the cluster is configured for"})
    dl = dl_container()
    if dl and dl["running"] and dl["repo"] in (repo, None):
        return out({"rc": 1, "out": f"{repo} is downloading — stop the download first"})
    cache = hf_cache(cache)
    name = "models--" + repo.replace("/", "--")
    if not os.path.isdir(os.path.join(cache, "hub", name)):
        return out({"rc": 0, "out": "not on disk"})
    rc, so, se = run(["docker", "run", "--rm", "--network", "none", "--entrypoint", "rm",
                      "-v", f"{cache}/hub:/hub", image, "-rf", f"/hub/{name}"], timeout=600)
    out({"rc": rc, "out": (so + se)[-500:]})


def download(image, repo, cache, rev=""):
    """Start `hf download` in a detached container, with the HF token from stdin.
    xet and hf_transfer are off: both have hung on large downloads on DGX Spark."""
    if not (SAFE_IMAGE.match(image) and SAFE_REPO.match(repo) and SAFE_PATH.match(cache)
            and (not rev or SAFE_REV.match(rev))):
        return out({"rc": 1, "out": "invalid arguments"})
    dl = dl_container()
    if dl and dl["running"]:
        return out({"rc": 0, "out": "download already running"})
    if dl:
        run(["docker", "rm", "-f", DL_NAME])
    cache = hf_cache(cache)
    os.makedirs(cache, exist_ok=True)
    env = dict(os.environ, HF_TOKEN=sys.stdin.read().strip())
    cmd = ["docker", "run", "-d", "--name", DL_NAME, "--network", "host",
           "-v", f"{cache}:/root/.cache/huggingface",
           "-e", "HF_TOKEN", "-e", "HF_HUB_ENABLE_HF_TRANSFER=0", "-e", "HF_HUB_DISABLE_XET=1",
           "-e", "HF_HUB_DOWNLOAD_TIMEOUT=30",
           "--entrypoint", "hf", image, "download", repo, "--max-workers", "8"]
    if rev:
        cmd += ["--revision", rev]
    p = subprocess.run(cmd, capture_output=True, text=True, timeout=3600, env=env)
    out({"rc": p.returncode, "out": (p.stdout + p.stderr)[-2000:]})


def download_stop():
    rc, so, se = run(["docker", "stop", DL_NAME], timeout=60)
    out({"rc": rc, "out": (so + se)[-500:]})


def garage(port):
    """GarageAI on this node, read as the normal user: the NetBird tunnel, the heartbeat timer
    and its last report, and whether vLLM answers on the mesh address (401 without a key).
    NetBird's JSON fields can move between versions, so every one is optional."""
    import shutil

    def run(cmd, timeout=15):  # tools a node may lack must not crash the report
        try:
            return globals()["run"](cmd, timeout=timeout)
        except (OSError, subprocess.SubprocessError):
            return 1, "", ""
    res = {"netbird": bool(shutil.which("netbird"))}
    if res["netbird"]:
        rc, so, se = run(["netbird", "status", "--json"])
        try:
            st = json.loads(so)
            m = st.get("management") or {}
            res.update({"daemon": st.get("daemonStatus"), "mesh_ip": (st.get("netbirdIp") or "").split("/")[0],
                        "fqdn": st.get("fqdn"), "management": m.get("connected"),
                        "management_url": m.get("url"), "peers": st.get("peers", {}).get("connected"),
                        "version": st.get("daemonVersion")})
        except ValueError:
            res["error"] = (se or so).strip()[-200:]
    rc, _, _ = run(["systemctl", "is-active", "--quiet", "garageai-heartbeat.timer"])
    res["heartbeat"] = rc == 0
    # The last report: exit 0 means GarageAI accepted it (the heartbeat uses curl -f). The reply
    # body is not a contract, so it is not read.
    rc, so, _ = run(["systemctl", "show", "garageai-heartbeat.service", "-p", "ExecMainStatus",
                     "-p", "ExecMainExitTimestamp", "--timestamp=unix"])
    kv = dict(l.split("=", 1) for l in so.splitlines() if "=" in l)
    ts = kv.get("ExecMainExitTimestamp", "").lstrip("@")
    if ts.isdigit():
        res["last"] = {"ts": int(ts), "ok": kv.get("ExecMainStatus") == "0"}
    if res.get("mesh_ip"):
        rc, so, _ = run(["curl", "-s", "-o", "/dev/null", "-w", "%{http_code}", "-m", "5",
                         f"http://{res['mesh_ip']}:{port}/v1/models"])
        res["mesh_api"] = so.strip() or None
    out(res)


def images():
    """Every image on the node, with whether a container (running or stopped) uses it."""
    rc, so, se = run(["docker", "images", "--digests", "--no-trunc", "--format", "{{json .}}"], timeout=30)
    if rc != 0:
        return out({"error": se.strip()[-200:]})
    rc2, used, _ = run(["docker", "ps", "-a", "--no-trunc", "--format", "{{.Image}}"], timeout=30)
    used_refs = set(used.split())
    seen = {}
    for line in so.splitlines():
        try:
            i = json.loads(line)
        except ValueError:
            continue
        iid = i.get("ID", "")
        e = seen.setdefault(iid, {"id": iid, "repo": i.get("Repository"), "tags": [], "digests": [],
                                  "size": i.get("Size"), "created": i.get("CreatedSince")})
        if i.get("Tag") not in (None, "<none>"):
            e["tags"].append(f"{i['Repository']}:{i['Tag']}")
        if i.get("Digest") not in (None, "<none>"):
            e["digests"].append(f"{i['Repository']}@{i['Digest']}")
    # docker ps names the image as it was started: by ID, tag or digest
    rc3, ids, _ = run(["docker", "ps", "-a", "--no-trunc", "--format", "{{.ID}}"], timeout=30)
    in_use = set()
    if ids.split():
        rc4, so4, _ = run(["docker", "inspect", "--format", "{{.Image}}", *ids.split()], timeout=30)
        in_use = set(so4.split())
    for e in seen.values():
        e["used"] = e["id"] in in_use or bool(used_refs & set(e["tags"] + e["digests"]))
    out({"images": list(seen.values())})


def remove_image(iid):
    """Remove one image, only if no container (running or stopped) was made from it."""
    if not re.match(r"^sha256:[0-9a-f]{64}$", iid):
        return out({"rc": 1, "out": "invalid image id"})
    rc, so, _ = run(["docker", "ps", "-a", "-q", "--filter", f"ancestor={iid}"], timeout=30)
    if so.strip():
        return out({"rc": 1, "out": "a container uses this image"})
    rc, so, se = run(["docker", "rmi", "-f", iid], timeout=300)
    out({"rc": rc, "out": (so + se)[-500:]})


def main():
    argv = shlex.split(os.environ.get("SSH_ORIGINAL_COMMAND", "") or " ".join(sys.argv[1:]))
    c = conf()
    cmd, args = (argv[0], argv[1:]) if argv else ("status", [])
    if cmd == "status":
        status(c, args)
    elif cmd == "scan":
        since = args[0] if args else None
        if since and not re.match(r"^[0-9T:.\-Z+]+$", since):
            return out({"error": "invalid time"})
        scan(c, since)
    elif cmd == "logs":
        since = args[1] if len(args) > 1 else None
        if since and not re.match(r"^[0-9T:.\-Z+]+$", since):
            return out({"error": "invalid time"})
        logs(c, max(1, min(int(args[0]) if args and args[0].isdigit() else 200, 5000)), since)
    elif cmd == "roce":
        out({"roce": roce(c)})
    elif cmd in ("up", "stop", "restart", "pull"):
        compose(c, *{"up": ["up", "-d"], "stop": ["stop"],
                     "restart": ["restart"], "pull": ["pull"]}[cmd],
                timeout=3600 if cmd == "pull" else 600)
    elif cmd == "reboot":
        reboot()
    elif cmd == "netdetect" and args and re.match(r"^[\d.]+$", args[0]):
        netdetect(args[0])
    elif cmd == "read" and args:
        readfile(c, args[0])
    elif cmd == "put" and args:
        putfile(c, args[0])
    elif cmd == "images":
        images()
    elif cmd == "remove-image" and args:
        remove_image(args[0])
    elif cmd == "pull-image" and args and SAFE_IMAGE.match(args[0]):
        rc, so, se = run(["docker", "pull", "-q", args[0]], timeout=3600)
        out({"rc": rc, "out": (so + se)[-500:]})
    elif cmd == "download" and len(args) >= 3:
        download(*args[:4])
    elif cmd == "delete-model" and len(args) == 3:
        delete_model(c, *args)
    elif cmd == "drop-caches":
        drop_caches()
    elif cmd == "download-stop":
        download_stop()
    elif cmd == "garage":
        garage(args[0] if args and args[0].isdigit() else "8000")
    elif cmd == "version":
        out({"agent": VERSION})
    else:
        out({"error": f"unknown command: {cmd}"})
        sys.exit(2)


if __name__ == "__main__":
    main()
